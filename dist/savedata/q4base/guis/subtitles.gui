// Quake 4 简体中文汉化项目 —— 语音字幕层（整块面板，Apex/HL2 风格）
// 由 q4game.dll 的 rvSubtitles 每帧驱动：
//   subBgY/subBgH/subBgA 面板位置/高度/透明度
//   subText0..7 / subTxtA0..7 / subRowY0..7 行文本/透明度/纵坐标
//   透明度由代码按行设置：角色对白全亮度，广播/无线电等环境音淡色（×0.62）
//   上限 8 行（2026-07-31 由 4 行放开，配合 cinematic 过滤避免乱入占满）
windowDef Desktop
{
	rect	0,0,640,480
	visible	1
	nocursor	1
	menugui	0

	windowDef subPanel
	{
		rect	130,"gui::subBgY",380,"gui::subBgH"
		backcolor	0,0,0,0.55
		visible	1
	}
	windowDef subText0
	{
		rect	136,"gui::subRowY0",368,13
		font	"fonts/lowpixel"
		textscale	0.19
		textalign	0
		forecolor	"gui::subTxtR0","gui::subTxtG0","gui::subTxtB0","gui::subTxtA0"
		text	"gui::subText0"
		visible	1
	}
	windowDef subText1
	{
		rect	136,"gui::subRowY1",368,13
		font	"fonts/lowpixel"
		textscale	0.19
