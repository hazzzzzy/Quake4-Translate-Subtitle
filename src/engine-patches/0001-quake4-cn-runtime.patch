+/*
+================
+SUB_CharAdvance
+
+单字符屏幕推进（640x480 虚拟像素）
+================
+*/
+static float SUB_CharAdvance( unsigned int cp ) {
+	float adv;
+	if ( cp < 128 ) {
+		adv = subAsciiAdv[cp];
+	} else if ( subWideAdv && cp < ( unsigned int )subWideNum && subWideAdv[cp] ) {
+		adv = subWideAdv[cp];
+	} else {
+		adv = SUB_WIDE_FALLBACK;
+	}
+	return adv * SUB_USE_SCALE;
+}
